function repoRoot = setupPaths()
% setupPaths  Add all repository subdirectories to the MATLAB search path.
    repoRoot = fileparts(mfilename('fullpath'));
    addpath(fullfile(repoRoot, 'simulation'));
    addpath(fullfile(repoRoot, 'analysis'));
    addpath(fullfile(repoRoot, 'figure_assembly'));
    addpath(fullfile(repoRoot, 'paper_figure'));
end

